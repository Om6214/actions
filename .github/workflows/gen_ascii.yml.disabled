name: Generate Ascii

on:
    push:
        branches: [main]

jobs:
    buildjob1:
        runs-on: ubuntu-latest
        steps:
            - name: Generate ASCII Art
              run: |
                sudo apt-get update
                sudo apt-get install -y cowsay
                cowsay -f dragon "Hello, Github actions!" > ascii_art.txt
            
            - name: Upload ASCII Art file
              uses: actions/upload-artifact@v4
              with:
                    name: ascii-art
                    path: ascii_art.txt

    testjob2:
        runs-on: ubuntu-latest
        needs: buildjob1
        steps:
            - name: Download ASCII Art file
              uses: actions/download-artifact@v4
              with:
                    name: ascii-art
                    path: .
            - name: Display ASCII Art
              run: |
                cat ascii_art.txt
    
            - name: Verify ASCII Art file
              run: |
                if [ -s ascii_art.txt ]; then
                  echo "ASCII Art file generated successfully."
                else
                  echo "ASCII Art file is empty!" >&2
                  exit 1
                fi
    
    deployjob3:
        runs-on: ubuntu-latest
        needs: testjob2
        steps:
            - name: Deploy ASCII Art
              run: |
                echo "Deploying ASCII Art..."
    

            