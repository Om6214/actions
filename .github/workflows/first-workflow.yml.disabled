name: sanity-check

on:
  push:
    branches: [ main ]


jobs:
  Report-Readme:
    runs-on: ubuntu-latest  
    steps:
      - name: Checkout code
        uses: actions/checkout@v6

      - name: List and Read files in the repo
        run: |
          echo "Listing files in the repository:"
          ls -lrat
          echo "Reading README.md content:"
          cat README.md
        
      - name: Generate ASCII Artwork
        run: cowsay -f tux "Sanity Check Passed! Repository is accessible and README.md is read successfully." >> ascii_art.txt
